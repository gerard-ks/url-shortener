# Ports
APP_PORT=8080
DB_PORT=5432

# PostgreSQL
POSTGRES_DB=urlshortener
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Application
APP_BASE_URL=http://localhost:8080

# Sécurité
# OBLIGATOIRE : Changer en production !
TOKEN_SECRET=change-me-in-production

# JPA
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# SSE
SSE_TIMEOUT=300000

# Nettoyage
CLEANUP_ENABLED=true
CLEANUP_RETENTION_DAYS=30
CLEANUP_BATCH_SIZE=1000
CLEANUP_CRON=0 0 3 * * *

# Rate Limiting
RATE_LIMIT_ENABLED=true

# Logging
LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO
EVENT_LOG_LEVEL=DEBUG

# Messages
MESSAGES_CACHE_DURATION=1h